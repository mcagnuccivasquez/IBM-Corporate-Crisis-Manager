# Copy to .env (gitignored) and fill in. Never commit .env.
# Each teammate uses their own key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# Models (D-012 hybrid): main model for A1-A4, light model for A0 intent/answers and A5
ACME_MODEL=claude-sonnet-5-5
ACME_MODEL_LIGHT=claude-haiku-5-5
# Where case state, PDFs and trace.jsonl are written
ACME_CASES_DIR=cases
